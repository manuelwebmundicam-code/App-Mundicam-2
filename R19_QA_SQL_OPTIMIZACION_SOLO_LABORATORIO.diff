     /**
+     * EXPERIMENTO QA: agrupa las lecturas RAW de _price/_sale_price/_regular_price.
+     * Misma semántica que raw_product_meta(): el último meta_id gana, sin filtros WP.
+     * Vigencia únicamente durante esta petición y únicamente en el sort B2B.
+     */
+    private static function qa_prime_raw_meta_for_sort(array $candidate_ids) {
+        if (!defined('MUNDICAM_QA_BULK_RAW_META') || !MUNDICAM_QA_BULK_RAW_META ||
+            !defined('DB_NAME') || DB_NAME !== 'mundicam_qa_r19' ||
+            home_url() !== 'http://127.0.0.1:8770') {
+            return;
+        }
+        global $wpdb;
+        $meta_by_id = [];
+        $ids = array_values(array_unique(array_filter(array_map('absint', $candidate_ids))));
+        foreach ($ids as $product_id) {
+            $meta_by_id[$product_id] = [];
+        }
+        foreach (array_chunk($ids, 80) as $batch) {
+            $placeholders = implode(',', array_fill(0, count($batch), '%d'));
+            $sql = $wpdb->prepare(
+                "SELECT post_id, meta_key, meta_value FROM {$wpdb->postmeta} " .
+                "WHERE post_id IN ($placeholders) AND meta_key IN ('_price','_sale_price','_regular_price') " .
+                "ORDER BY meta_id DESC",
+                ...$batch
+            );
+            $rows = $wpdb->get_results($sql, ARRAY_A);
+            if (!is_array($rows)) {
+                throw new RuntimeException('QA bulk RAW meta read failed.');
+            }
+            foreach ($rows as $row) {
+                $product_id = (int) $row['post_id'];
+                $key = (string) $row['meta_key'];
+                if (isset($meta_by_id[$product_id]) &&
+                    !array_key_exists($key, $meta_by_id[$product_id])) {
+                    $meta_by_id[$product_id][$key] = $row['meta_value'];
+                }
+            }
+        }
+        self::$qa_sort_raw_meta = $meta_by_id;
+    }
+
